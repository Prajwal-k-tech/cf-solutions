{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build: g++ active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++23",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Compile active .cpp file only"
        },
        {
            "type": "shell",
            "label": "Run: build & run in terminal",
            "command": "g++ -fdiagnostics-color=always -g -std=c++17 \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && echo '--- Build OK ---' && \"${fileDirname}/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "detail": "Build & run in terminal with stdin support"
        }
    ],
    "version": "2.0.0"
}
